# Configuración de Google Gemini API
# Obtené tu clave gratuita en: https://aistudio.google.com/
GEMINI_API_KEY=tu_api_key_aqui

# Modelo de Gemini recomendado
GEMINI_MODEL=gemini-2.5-flash

# Servidor Web local
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Token de acceso para HUD, API y micrófono remoto. Generá uno largo y aleatorio.
TITAN_API_TOKEN=

# Token exclusivo del satélite Windows. Debe ser distinto al token de API.
TITAN_SATELLITE_TOKEN=

# Identidad individual del dispositivo que usa TITAN_SATELLITE_TOKEN
TITAN_DEVICE_ID=windows-satellite

# Exige registro individual para todo acceso remoto a Titán
TITAN_DEVICE_AUTH_REQUIRED=true

# Wake-on-LAN de la PC Windows principal (MAC de la interfaz conectada por LAN)
WINDOWS_MAC_ADDRESS=
WINDOWS_WOL_BROADCAST=255.255.255.255
